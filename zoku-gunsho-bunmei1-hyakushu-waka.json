  },
  {
   "seq": "10",
   "text": "二葉よりをのかさま〳〵もえ出てひとつ草ともみえぬ春哉",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "水草",
   "kotobagaki": ""
  },
  {
   "seq": "11",
   "text": "霞む夜の月もかこたし是そこの昔なからの春の面かけ",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春月",
   "kotobagaki": ""
  },
  {
   "seq": "12",
   "text": "いつとなく心そらなるより衣きてはとまらぬ春のかへみさ",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "帰暦",
   "kotobagaki": ""
  },
  {
   "seq": "13",
   "text": "此あさけと山の桜咲遣らしうつろひそむか嶺のしら雲",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初花",
   "kotobagaki": ""
  },
  {
   "seq": "14",
   "text": "山さとにすむ身となれは帰るさを忘れし図の春そ恋しき",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "見花",
   "kotobagaki": ""
  },
  {
   "seq": "15",
   "text": "こん世にもみかめにあらぬ蜑と成て花の渕にや身をしつめてん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "翫花",
   "kotobagaki": ""
  },
  {
   "seq": "16",
   "text": "おしむ身のするそ定めぬ咲花は常なる花の世こそ有けれ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "惜蔵",
   "kotobagaki": ""
  },
  {
   "seq": "17",
   "text": "さそはりつらさに出して春風の吹をかことにちるさくらかな",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "落花",
   "kotobagaki": ""
  },
  {
   "seq": "18",
   "text": "秋の色もそれかと匂ふ山吹のまかきは霧の面かけそたつ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "難歎歟",
   "kotobagaki": ""
  },
  {
   "seq": "19",
   "text": "一松の葉をしからみかけて行者のいせきの山に咲る藤なみ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "松上藤",
   "kotobagaki": ""
  },
  {
   "seq": "20",
   "text": "道明のかたふく山共うす霞春もそなたに残るとそみる",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "善春",
   "kotobagaki": ""
  },
  {
   "seq": "21",
   "text": "たちかふるけさの袂のぬれ衣は花のなき名にしほれけらしも",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "首夏",
   "kotobagaki": ""
  },
  {
   "seq": "22",
   "text": "〽おほつかな忍ふ夜比は時名のらてあらぬ音をや鳴らん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "待郭公",
   "kotobagaki": ""
  },
  {
   "seq": "23",
   "text": "鳴ふるす里にて身とほとゝきすあかぬ心そかはらさりける",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "関郭公",
   "kotobagaki": ""
  },
  {
   "seq": "24",
   "text": "片そはの山田のさなへ一むらにいそく乙女のたつきおのよや",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "早苗",
   "kotobagaki": ""
  },
  {
   "seq": "25",
   "text": "岸たかき谷のふせやのたる池もさしくむ斗五月雨そふる",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "亥五月雨",
   "kotobagaki": ""
  },
  {
   "seq": "26",
   "text": "たれ行てかり地のをのゝ薄草我々まゝさにのこすしけとを",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏草",
   "kotobagaki": ""
  },
  {
   "seq": "27",
   "text": "影しあれは岩井の水を結ふての雫のまゝに月もめかれす",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏月",
   "kotobagaki": ""
  },
  {
   "seq": "28",
   "text": "月やとる朧の清水とふほたるをのか光とさたかにもなき",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "水辺蛍",
   "kotobagaki": ""
  },
  {
   "seq": "29",
   "text": "大江山こえ行雲のあしまこいくのを過るゆふ立の雨",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夕立",
   "kotobagaki": ""
  },
  {
   "seq": "30",
   "text": "ゆふかけて斯る御祓の川やしろ神も神をやけふはなこむか",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "六月抜",
   "kotobagaki": ""
  },
  {
   "seq": "31",
   "text": "吹にけりしのたのもりの葛のはに有しにかへる秋の初風",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "早秋",
   "kotobagaki": ""
  },
  {
   "seq": "32",
   "text": "雲の上の星のしらへは名をか遣し一夜のこそ更に忘れぬ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "乞巧奠",
   "kotobagaki": ""
  },
  {
   "seq": "33",
   "text": "一音漬るたよりすくさて荻のはのいく秋風にそよきそふらん",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "萩",
   "kotobagaki": ""
  },
  {
   "seq": "34",
   "text": "妻こふる涙なりけり夕間暮しか鳴草の花のうは露",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "萩露",
   "kotobagaki": ""
  },
  {
   "seq": "35",
   "text": "老ぬらしうきゝ心のたえかねて涙のおつる秋の夕くれ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋夕",
   "kotobagaki": ""
  },
  {
   "seq": "36",
   "text": "やつれこし旅はさこそと思へともいつしかなれや衣かりかね",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初雁",
   "kotobagaki": ""
  },
  {
   "seq": "37",
   "text": "一末をゝもみかたふく小田のほの上にのほるも下る秋のして露",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋田",
   "kotobagaki": ""
  },
  {
   "seq": "38",
   "text": "思ひあれは長夜あかす鳴しかのねられす我も聞明しぬる",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夜鹿",
   "kotobagaki": ""
  },
  {
   "seq": "39",
   "text": "きり〳〵す枕の下に鳴よりて老のね是の哀をそとふ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暁由",
   "kotobagaki": ""
  },
  {
   "seq": "40",
   "text": "たれつけてこゝに澄らん月よしともみぬ山陰の里",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山同",
   "kotobagaki": ""
  },
  {
   "seq": "41",
   "text": "みちひなき塩津のかたのはる〳〵と月なきたる夜はのさゝ波",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "御用",
   "kotobagaki": ""
  },
  {
   "seq": "42",
   "text": "大空の思ひなしにやすむほともほとなきまやのあつまのゝ月",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "野同",
   "kotobagaki": ""
  },
  {
   "seq": "43",
   "text": "いさりするあまにはあらしたそや此なるとの沖の月にこたに",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "渡月",
   "kotobagaki": ""
  },
  {
   "seq": "44",
   "text": "秋源支山の木葉のしくるれはふもとの庭の月そうつろふ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "庭月",
   "kotobagaki": ""
  },
  {
   "seq": "45",
   "text": "行人もみえぬはかりにたつか弓きの関の戸の秋の夕きり",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "関弟",
   "kotobagaki": ""
  },
  {
   "seq": "46",
   "text": "更ぬるかとをちのかねも打衣同しひゝきの霜わさえつゝ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "関構衣",
   "kotobagaki": ""
  },
  {
   "seq": "47",
   "text": "仙人のもゝをうかへし粋の中にきくの昼又めくるらし",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "重陽宴",
   "kotobagaki": ""
  },
  {
   "seq": "48",
   "text": "もみちより外にはそめて何かせんあたら時雨のもりの下草",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "杜紅葉",
   "kotobagaki": ""
  },
  {
   "seq": "49",
   "text": "らすくこき色こそやかて飛鳥川うつと紅葉の渕士なりけれ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "河紅葉",
   "kotobagaki": ""
  },
  {
   "seq": "50",
   "text": "なこりのみしたふ袂に置そへて露は尽遣ぬ秋の暮かな",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "九月昼",
   "kotobagaki": ""
  },
  {
   "seq": "51",
   "text": "いつしかと柴の庵の冬かまへかこひそへてももる時な哉",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初冬時雨",
   "kotobagaki": ""
  },
  {
   "seq": "52",
   "text": "夏はふく蝉のは山にちる木葉声の時雨そかはらさりける",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "落葉",
   "kotobagaki": ""
  },
  {
   "seq": "53",
   "text": "夢かとも雪よりさきにとひて見よ小のゝ子稚の箱根の色",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寒草",
   "kotobagaki": ""
  },
  {
   "seq": "54",
   "text": "〽おくも又ふかくは見えす山人の噺におへるけさの薄香",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "浅香",
   "kotobagaki": ""
  },
  {
   "seq": "55",
   "text": "降雪に秋の宮人尋こしあとはむかしのをのゝ山さと",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "積雪",
   "kotobagaki": ""
  },
  {
   "seq": "56",
   "text": "朝日さすか遣ひのおかれ先解て氷にかゝる池のしらなみ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "池水",
   "kotobagaki": ""
  },
  {
   "seq": "57",
   "text": "愛ちるとよのあかりの夜はさえて乱るゝ玉のをみの衣手",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "豊明養入守",
   "kotobagaki": ""
  },
  {
   "seq": "58",
   "text": "有明の雲間の月のうす氷くたけてかゝる村しくれかな",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬月",
   "kotobagaki": ""
  },
  {
   "seq": "59",
   "text": "友たとりまた浦つたひきさかたやあまの苫屋も同し夜遣に",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "潟千鳥",
   "kotobagaki": ""
  },
  {
   "seq": "60",
   "text": "いつまてか老を我身のよそとせにおほくもあまる年の暮哉",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "歳暮",
   "kotobagaki": ""
  },
  {
   "seq": "61",
   "text": "君こんとたのまぬものゝ出し犬はなかめを更る山端の月",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄月忘",
   "kotobagaki": ""
  },
  {
   "seq": "62",
   "text": "かつらきや嶺のうき雲跡もなし近所に立居もかゝらましかは",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄雲恋",
   "kotobagaki": ""
  },
  {
   "seq": "63",
   "text": "明ぬとてつれなく出る推柴のとかへる山は打しくれ筒",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄る恋",
   "kotobagaki": ""
  },
  {
   "seq": "64",
   "text": "人しれす心の松にはくかな音せぬ暮の風のれしきは",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄風恋",
   "kotobagaki": ""
  },
  {
   "seq": "65",
   "text": "〽いかにせんむねの外に立消て恋のそふりはしるへとなし",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄烟恋",
   "kotobagaki": ""
  },
  {
   "seq": "66",
   "text": "我袖は清見かなみの関なからもりてかひなきらき名にそたつ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄関恋",
   "kotobagaki": ""
  },
  {
   "seq": "67",
   "text": "思ひかね岩間の波のうち出て心のたきの音しらせぬめ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄瀧慈",
   "kotobagaki": ""
  },
  {
   "seq": "68",
   "text": "及なき思ひをふしのねに鳴て袖はなみたに浮島かはら",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄原恋",
   "kotobagaki": ""
  },
  {
   "seq": "69",
   "text": "里の名もわかみの上にまさしくはかけてもとはしうちのはし守",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄橋恋",
   "kotobagaki": ""
  },
  {
   "seq": "70",
   "text": "我袖のこなとによするしるへせよ外行舟のあとの追乱",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄漆恋",
   "kotobagaki": ""
  },
  {
   "seq": "71",
   "text": "さくら花うのよりあたの人こゝろ残りならこそ腹ひえけれ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄木恋",
   "kotobagaki": ""
  },
  {
   "seq": "72",
   "text": "言の葉をかき重ねつゝ浜ゆふのいくえもいはゝ哀とやこん",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄草恋",
   "kotobagaki": ""
  },
  {
   "seq": "73",
   "text": "鳴くらし夜はたもゆる夏虫母我身ひとつのためしとそ出る",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄虫恋",
   "kotobagaki": ""
  },
  {
   "seq": "74",
   "text": "一暁はならぬ翅の鳥なれやつらき別をしらてしもなく",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄鳥恋",
   "kotobagaki": ""
  },
  {
   "seq": "75",
   "text": "床もしれふすゐのかるもかくれ筒こぬよは塵のつもる帳を",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄獣恋",
   "kotobagaki": ""
  },
  {
   "seq": "76",
   "text": "光ある袖の涙の玉ならはよるたにもらすひきやなからん",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄玉恋",
   "kotobagaki": ""
  },
  {
   "seq": "77",
   "text": "さきの世のむくひのかけもくもり出き恋こそつこのかえ成けれ",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄鏡恋",
   "kotobagaki": ""
  },
  {
   "seq": "78",
   "text": "桜やらぬ涙のとこの埋木や我人しれぬまくら成らん",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄枕恋",
   "kotobagaki": ""
  },
  {
   "seq": "79",
   "text": "山さとの鳥の音きけは哀なるあらぬね覚の旅心地して",
   "kana": "",
   "speaker": "下句欠",
   "page": 9,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暁鶏",
   "kotobagaki": ""
  },
  {
   "seq": "80",
   "text": "身をてらす法と書との為ならてむかふは出しきよかつと云し火",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夜燈",
   "kotobagaki": ""
  },
  {
   "seq": "81",
   "text": "谷こしのむかひにたかき崩つゝき外面に成くる松の村立",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "崩松",
   "kotobagaki": ""
  },
  {
   "seq": "82",
   "text": "かきこもる便もあれやくれ竹のそのふのかけの大原のさと",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "里竹",
   "kotobagaki": ""
  },
  {
   "seq": "83",
   "text": "一塩のまに磯の中道あさりして岩かねしのき玉もかる身そ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "様厳",
   "kotobagaki": ""
  },
  {
   "seq": "84",
   "text": "しらつるの立るすかたはこらしまのこやいましへの翁さひぬる",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "島鶴",
   "kotobagaki": ""
  },
  {
   "seq": "85",
   "text": "かりのよに残る計のつれなさや我友岡のさゝの一むら",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "岡篠",
   "kotobagaki": ""
  },
  {
   "seq": "86",
   "text": "難波なる入江のあしの夏かりは今はた同し若葉さすに也",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "江戸",
   "kotobagaki": ""
  },
  {
   "seq": "87",
   "text": "もしほやくあまのしわさの釣にやけふりの波に又こかるらん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "浦船",
   "kotobagaki": ""
  },
  {
   "seq": "88",
   "text": "法の師のわかたつそまの名も高きをひえの杣にいく世へぬらん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "杣山",
   "kotobagaki": ""
  },
  {
   "seq": "89",
   "text": "多きはしるきしの岩間にむす苺はさらしさらさぬ布かとそみる",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "岸苔",
   "kotobagaki": ""
  },
  {
   "seq": "90",
   "text": "濁る世に心ひかれて山水の深きかたにはすみもならはす",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山家水",
   "kotobagaki": ""
  },
  {
   "seq": "91",
   "text": "みぬわたるあらしの下にならしとの廬の松は音も聞えす",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山家嵐",
   "kotobagaki": ""
  },
  {
   "seq": "92",
   "text": "かりほもか袖いかはかりしほるらんいなはそよめき村雨そくする",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "田家雨",
   "kotobagaki": ""
  },
  {
   "seq": "93",
   "text": "真めや一夜の宿の行末に又わけ侘し茶かみぬこえ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "旅行",
   "kotobagaki": ""
  },
  {
   "seq": "94",
   "text": "草まくらたゝかりそめと思ひねの夢の中にも世を過す哉",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "旅宿",
   "kotobagaki": ""
  },
  {
   "seq": "95",
   "text": "風あらきなみのよすかのいかりなは心細くもらきねする哉",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "旅泊",
   "kotobagaki": ""
  },
  {
   "seq": "96",
   "text": "こき出て和田の沖よりなかむれは猶はてもなき末の白浪",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "海眺望",
   "kotobagaki": ""
  },
  {
   "seq": "97",
   "text": "あそしめて神もひやえふみ山みねの岩ほの動きなき世に",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄社祝",
   "kotobagaki": ""
  },
  {
   "seq": "98",
   "text": "くもりなく出てそ守る朝彦の御影は君か国のためかも",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733739",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄日祝",
   "kotobagaki": ""
  }
 ],
